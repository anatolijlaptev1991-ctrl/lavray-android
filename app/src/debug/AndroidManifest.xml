<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: lets `adb shell am broadcast` drive the core API for device
             verification. Guarded by DUMP, which the shell holds and ordinary apps cannot get. -->
        <receiver
            android:name=".debug.DebugApiReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
